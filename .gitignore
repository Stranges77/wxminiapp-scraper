# ============================================================
#  wxminiapp-scraper .gitignore
# ============================================================

# ===== 密钥 / 凭证 (绝对不能上传) =====
*auth*.json
*cookie*
*.token
.env
.env.*

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# ===== Node.js =====
node_modules/

# ===== 采集产物 (output/ 整个目录都不入库) =====
output/

# ===== 备份 / 压缩包 =====
*.rar
*.zip
*.7z
*.bak

# ===== 系统 / IDE =====
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
